    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="Ruth Sima Rigamu" TIER_ID="text">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann650" ANNOTATION_REF="ann649">
                <ANNOTATION_VALUE>Kopihoo</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann653" ANNOTATION_REF="ann652">
                <ANNOTATION_VALUE>O naono vai o kopihoo na paku riori bono aga no sinivi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann656" ANNOTATION_REF="ann655">
                <ANNOTATION_VALUE>A abana na mosi maari bono kopihoo vai o totobin, ore paa hihi maa bari rasuu, ore paa dee tavus vo hanana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann659" ANNOTATION_REF="ann658">
                <ANNOTATION_VALUE>Vaasun vai ori, ore paa raka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann662" ANNOTATION_REF="ann661">
                <ANNOTATION_VALUE>Be raka, ore paa dee voosu maa bari,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann665" ANNOTATION_REF="ann664">
                <ANNOTATION_VALUE>ore paa ma taraha bona ihu no kopihoo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann668" ANNOTATION_REF="ann667">
                <ANNOTATION_VALUE>ore paa taraha bona meha papana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann671" ANNOTATION_REF="ann670">
                <ANNOTATION_VALUE>Be kavara, ore paa asi ni bono buo ihu aga ore tara vamataa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann674" ANNOTATION_REF="ann673">
                <ANNOTATION_VALUE>Bea abana pampamu vakavara ore paa tapa ni bono aga teo sinivi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann677" ANNOTATION_REF="ann676">
                <ANNOTATION_VALUE>O buo naono vai to tapa aga ni raara ei o kopihoo bara o roge.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
