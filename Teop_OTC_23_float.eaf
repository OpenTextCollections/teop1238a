    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="text" PARTICIPANT="unknown" TIER_ID="free transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4285" ANNOTATION_REF="ann650">
                <ANNOTATION_VALUE>Kopihoo tree</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4286" ANNOTATION_REF="ann653">
                <ANNOTATION_VALUE>The kopihoo tree is used for making the float of the outrigger canoe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4287" ANNOTATION_REF="ann656">
                <ANNOTATION_VALUE>The men cut a straight kopiho tree, then they remove its bark in the jungle and carry it out of the bush to the trail.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4288" ANNOTATION_REF="ann659">
                <ANNOTATION_VALUE>They stand it up there to dry.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4289" ANNOTATION_REF="ann662">
                <ANNOTATION_VALUE>When it is dry, they carry it home.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4290" ANNOTATION_REF="ann665">
                <ANNOTATION_VALUE>and plane the surface of the nose of the kopiho log</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4291" ANNOTATION_REF="ann668">
                <ANNOTATION_VALUE>Then they plane the surface of the other side.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4292" ANNOTATION_REF="ann671">
                <ANNOTATION_VALUE>After that, they burn the two noses of the floater to look beautiful.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4293" ANNOTATION_REF="ann674">
                <ANNOTATION_VALUE>When the men have done the lashing (i.e. have lashed the vanai to the canoe), they fix the float  to (the outrigger boom of) the canoe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4294" ANNOTATION_REF="ann677">
                <ANNOTATION_VALUE>The two trees that we build floats from are the kopihoo tree and the coastal hibiscus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
