    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="Ruth Sima Rigamu" TIER_ID="text">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann572" ANNOTATION_REF="ann571">
                <ANNOTATION_VALUE>KARAA</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann575" ANNOTATION_REF="ann574">
                <ANNOTATION_VALUE>O karaa to vin vonaha ni ria ta Teapu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann578" ANNOTATION_REF="ann577">
                <ANNOTATION_VALUE>Na kosi riori ore paa kahu bono sinoo vaa toon no paka karaa, ore paa vaameapa bari tea roava.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann581" ANNOTATION_REF="ann580">
                <ANNOTATION_VALUE>Me meapa, ore paa rava bari ge eori repaa nahu bari bona tahii.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann584" ANNOTATION_REF="ann583">
                <ANNOTATION_VALUE>Murinae eori repaa varoava bari.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann587" ANNOTATION_REF="ann586">
                <ANNOTATION_VALUE>Varoava riori antee beo karaa gaoho komana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann590" ANNOTATION_REF="ann589">
                <ANNOTATION_VALUE>KARAA TOUTOU</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann593" ANNOTATION_REF="ann592">
                <ANNOTATION_VALUE>O karaa toutou na bero kurus nana kasuana teara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann596" ANNOTATION_REF="ann595">
                <ANNOTATION_VALUE>Pura pinopino batana mee,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann599" ANNOTATION_REF="ann598">
                <ANNOTATION_VALUE>ei kou o vua nae to oro binubinu batana tahii.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann602" ANNOTATION_REF="ann601">
                <ANNOTATION_VALUE>O karaa bona na vaapeha mi nana bono karaa vai o hiki toutou.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann605" ANNOTATION_REF="ann604">
                <ANNOTATION_VALUE>A taba to vaavaha koa ni nana teo buo karaa bona, o meho na tei mi nana bono toutou teo buo vavaarihi bara toon nae, o meho me ahiki.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann608" ANNOTATION_REF="ann607">
                <ANNOTATION_VALUE>Eara na kahu rara o buo vavaarihi no paka karaa bara toon nae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann611" ANNOTATION_REF="ann610">
                <ANNOTATION_VALUE>O karaa bona mee o gagaoho pete kurus. O karaa bona o mataa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann614" ANNOTATION_REF="ann613">
                <ANNOTATION_VALUE>Na vin hoi bara vonaha ni ria maa moon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann617" ANNOTATION_REF="ann616">
                <ANNOTATION_VALUE>KARAA VAA SOLOMON</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann620" ANNOTATION_REF="ann619">
                <ANNOTATION_VALUE>O karaa vai o hiki toutou na deedee maa rohori Solomon meara na dao koa rara e bona karaa vaa Solomon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann623" ANNOTATION_REF="ann622">
                <ANNOTATION_VALUE>Ahiki to toutou teve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann626" ANNOTATION_REF="ann625">
                <ANNOTATION_VALUE>Eara na kahu vatamee koara a toon na maa paka karaa, ore tamee tea rigunu ei beara tau nahue.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann629" ANNOTATION_REF="ann628">
                <ANNOTATION_VALUE>O karaa bona o gaohogaoho kurus, o tamee kurus mee.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann632" ANNOTATION_REF="ann631">
                <ANNOTATION_VALUE>Na mataa kurus nana tea vin vonaha, hoi ae haata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
