        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4261" ANNOTATION_REF="ann578">
                <ANNOTATION_VALUE>They cut the pandanus leaves and then scrape the midrib on the back of the pandanus leaves, and let them become flexible in the sun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4262" ANNOTATION_REF="ann581">
                <ANNOTATION_VALUE>And (when the pandanus leaves) are flexible, they  heat them over the fire or cook them in saltwater.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4263" ANNOTATION_REF="ann584">
                <ANNOTATION_VALUE>After that ithey put them put into the sun (to dry).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4264" ANNOTATION_REF="ann587">
                <ANNOTATION_VALUE>They put (them) in the sun until the pandanus is bleached.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4265" ANNOTATION_REF="ann590">
                <ANNOTATION_VALUE>THORNY PANDANUS (pandanus spiralis)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4266" ANNOTATION_REF="ann593">
                <ANNOTATION_VALUE>The Thorny Pandanus is very common in our coastal area.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4267" ANNOTATION_REF="ann596">
                <ANNOTATION_VALUE>(It) grows everywhere without any care.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4268" ANNOTATION_REF="ann599">
                <ANNOTATION_VALUE>because its seeds float around everywhere in the sea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4269" ANNOTATION_REF="ann602">
                <ANNOTATION_VALUE>This pandanus is similar to the pandanus without thorns.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4270" ANNOTATION_REF="ann605">
                <ANNOTATION_VALUE>The only thing that is different with these two kinds of pandanus is that one has thorns on the two sides of the leaf and on its back, but the other one does not.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4271" ANNOTATION_REF="ann608">
                <ANNOTATION_VALUE>We scrape the two sides of the leaf and its back.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4272" ANNOTATION_REF="ann611">
                <ANNOTATION_VALUE>This pandanus is also very white. This pandanus is good.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4273" ANNOTATION_REF="ann614">
                <ANNOTATION_VALUE>The women use it for plaiting baskets and weaving mats.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4274" ANNOTATION_REF="ann617">
                <ANNOTATION_VALUE>SOLOMON PANDANUS</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4275" ANNOTATION_REF="ann620">
                <ANNOTATION_VALUE>The pandanus without thorns was brought from the Solomon Islands, and we just call it the Solomon pandanus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4276" ANNOTATION_REF="ann623">
                <ANNOTATION_VALUE>It does not have any thorns.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4277" ANNOTATION_REF="ann626">
                <ANNOTATION_VALUE>We only scrape the back of the pandanus leaves to make them flexible so that they are flexible to wind them up when we cook them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4278" ANNOTATION_REF="ann629">
                <ANNOTATION_VALUE>This pandanus is very white, but also very flexible.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4279" ANNOTATION_REF="ann632">
                <ANNOTATION_VALUE>It is very good for plaiting mats, baskets and hats.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
