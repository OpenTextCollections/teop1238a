    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="Helen Kobaa Magum &amp; Shalom Magum" TIER_ID="text">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>Enaa kahi vahutate ni nom havee to suvasuva vaavaha mi raara a paka suva, eara a ta Teapu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>Beara mei rara tea nao tea suvasuva tea masi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>eara toro matatopo roho amaa taba to pasi dee raara tea suvasuva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>Momohu eara toro nao rasuu tea osi paka suva teo hum to neba komana raara eve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann13" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>Beara osi, eara toro osi vaberobero, eara repaa dee voosu eve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>Beara tau nao, eara repaa vaobete a paka suva teo hoi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>Eara repaa kae vo tea masi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>Beara no suguna tea kopua, eara repaa tara voen, o iana na tei rori teebona,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann25" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>eara repaa vahio o hoi paka suva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>Eara repaa taneo tea buhaha a paka suva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>Buhaha bata mi raara bono kasuana to karusu bata raara komana kopua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>Eara buhaha batara, beara peo binubinu bata ni rae komana kopua, ge tea maa avaava teo vasu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann37" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>Beara suva batara, eara repaa tara voen o iana na mate batari, eara repaa antee tea buhaha a paka suva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>Eara repaa taneo tea mosi o iana to bubuutoo bata maana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>A paka suva vai to paa buhaha vuru ara, na kaokahi koa raara komana kopua,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>ei kou paa kavara vaevuru a kikis nae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann49" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>Eara repaa kae voosu o hoi iana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>Eve koai o sii vahutate kakato vaa tea suvasuva nia paka suva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="text" PARTICIPANT="unknown" TIER_ID="free transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann1">
                <ANNOTATION_VALUE>I am going to describe how we poison fish with suva leaves, we the Teop people.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann5" ANNOTATION_REF="ann4">
                <ANNOTATION_VALUE>Before we go to poison fish on the reef at low tide,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann7">
                <ANNOTATION_VALUE>we must prepare the things that we take with us to poison fish.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann10">
                <ANNOTATION_VALUE>First we must go to the forest to pick the fish poisoning leaves at the place where we plant them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann13">
                <ANNOTATION_VALUE>When we pick (the leaves), we must pick plenty, and then we carry them home.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann17" ANNOTATION_REF="ann16">
                <ANNOTATION_VALUE>Before we go (to the reef), we put the suva leaves into a basket.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann19">
                <ANNOTATION_VALUE>Then we carry (it) to the reef at low tide.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann22">
                <ANNOTATION_VALUE>When we arrive at a pool and see that there are the fish,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann25">
                <ANNOTATION_VALUE>we put the basket with the suva leaves down.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann29" ANNOTATION_REF="ann28">
                <ANNOTATION_VALUE>Then we start rubbing the suva leaves into pulp with our hands.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann31">
                <ANNOTATION_VALUE>We rub them with sand that we collect with our hands in the pool.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann34">
                <ANNOTATION_VALUE>We rub them into pulp while scattering them everywhere in the pool or in the caves in the stones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann37">
                <ANNOTATION_VALUE>When we do the poisoning, and we see that the fish are dying, we stop rubbing the suva leaves into pulp.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann41" ANNOTATION_REF="ann40">
                <ANNOTATION_VALUE>Then we start killing the struggling fish with a knife.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann43">
                <ANNOTATION_VALUE>The suva leaves that we have rubbed into pulp we leave in the pool.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann46">
                <ANNOTATION_VALUE>because their strength has already gone,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann49">
                <ANNOTATION_VALUE>We then carry the basket full of fish home.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann53" ANNOTATION_REF="ann52">
                <ANNOTATION_VALUE>This is the short description of poisoning fish with suva leaves.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
