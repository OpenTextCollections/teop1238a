    <TIER LINGUISTIC_TYPE_REF="f" PARENT_REF="free transl." PARTICIPANT="unknown" TIER_ID="lit. transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3150" ANNOTATION_REF="ann17">
                <ANNOTATION_VALUE>(lit. The ariono vine, also, it is another vine a good one.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3137" ANNOTATION_REF="ann20">
                <ANNOTATION_VALUE> (lit. It (is) what the men fish with in the sea.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3138" ANNOTATION_REF="ann32">
                <ANNOTATION_VALUE>(lit. The grass, it (is) the food of the cows.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3153" ANNOTATION_REF="ann35">
                <ANNOTATION_VALUE>(lit. In the past, we - there was not any grass.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3140" ANNOTATION_REF="ann59">
                <ANNOTATION_VALUE>(lit. There just was not any eat(ing fish of us.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3154" ANNOTATION_REF="ann98">
                <ANNOTATION_VALUE>(lit. The passionflower, it (is) also another vine that is in the garden)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3141" ANNOTATION_REF="ann137">
                <ANNOTATION_VALUE>(lit. The calamus cane, its work (is) very important.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3157" ANNOTATION_REF="ann158">
                <ANNOTATION_VALUE>(lit. This black wild banana plant we call orovi.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3158" ANNOTATION_REF="ann161">
                <ANNOTATION_VALUE></ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3159" ANNOTATION_REF="ann164">
                <ANNOTATION_VALUE></ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3142" ANNOTATION_REF="ann188">
                <ANNOTATION_VALUE>(lit. The name Farting Weed, it stays with it,  this (is) how it happens.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3143" ANNOTATION_REF="ann191">
                <ANNOTATION_VALUE>(/lit. When you uproot it, (it) does not ever get uprooted indeed, then it stops when you fart (your)self.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3139" ANNOTATION_REF="ann218">
                <ANNOTATION_VALUE>(lit. It (is) the thing because of which it is good.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3166" ANNOTATION_REF="ann230">
                <ANNOTATION_VALUE>(lit. The raviana vina, it (is) a vine that they tie up the canoe with.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3169" ANNOTATION_REF="ann263">
                <ANNOTATION_VALUE>(lit. ... then you put it on the split-off place.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3172" ANNOTATION_REF="ann269">
                <ANNOTATION_VALUE>(lit. The wild banana sheath strap, it (is) what we carry backpacks (with).)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
