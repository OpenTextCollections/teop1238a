    <TIER LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="unknown" TIER_ID="text">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>KARA AISI</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>O kara aisi, eve o meho kara naono to abeabe batana tea maa kasuana vaa Hanatana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>O kara aisi bona na tei nana kasuana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>Ahiki vira ta kiu teve vo teara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann13" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>KARA ARIONO</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>O kara ariono mee, eve o meho kara koris o kara mataa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>Eve to vagana ni ria abana tahii.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>Beori nao tahii eori toro gono bona kara ariono mene a vavaatoa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann25" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>Na paku vavaatoa ni rori bona kara ariono.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>KARA BAO</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>A kara bao, eve a tabaan teo burumakao.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>Nabunuu roho enam ahiki to kara bao.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann37" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>O burumakao he nomaa koa meori paa ma neba bata kiri bari bono kara bao.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>Mea naba kasi hanana paa dee taataana bata maa bari.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>Rerau mepaa raha bata maa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>Me nomana amaa mohina teara na hapus kurus nana tea kara bao.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann49" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>KARA KAVE</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>O kara kave eve o meho kara koris vai to tei me nana bona kiu a beera sana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>Nabunuu roho beo kara kave vai hiki nana,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann58" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>ahiki koa ta an iana teara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann61" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>Eikou o kara kave to paku riori bona kanono</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann64" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>ore paa paku pete bari bona kave mene vagana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>KARA KORIS</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann70" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>O kara koris eve o meho kara naono.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann73" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>O kara koris bona na tei pete nana rasuu ei mohina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann76" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>O kara koris bona na vaahiroo ni raara, na dao raara bono kara koremana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>Bea moon vahuhu, ore paa vaahiroo bari bono kara koremana, ei bea huhu tea moon vagitagita nana,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann82" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>a huhu nae repaa hapus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann85" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>A pate koris bona a paapao.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann88" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>Eve o paapao o mataa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>“Hiroo a kara korisi bona.”</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann94" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>KARA KUSKUS</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann97" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>O kara kuskus eve mee o meho kara koris to tei nana mohina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann100" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>O kara kuskus bona na vuavua nana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann102">
                <ANNOTATION_VALUE>Bea vuanae manoto, ore paa tomtomon,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann106" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>ei be vuri.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann109" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>“Enaa na rake nom tea ani to vua kuskus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann112" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>O vua kuskus bona o vua mataa kurus.“</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann118" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>O kara kuskus na tei nana rasuu,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann121" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>Na hiri batana tea maa pasunana tenam.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann124" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>Be vua, ore paa hana batana teo kara nae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann127" ANNOTATION_REF="ann126">
                <ANNOTATION_VALUE>Beove vuri, ore paa tomtomon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann130" ANNOTATION_REF="ann129">
                <ANNOTATION_VALUE>A vua no kara kuskus a vua mataa kurus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann133" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>KARA OBAI</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann136" ANNOTATION_REF="ann135">
                <ANNOTATION_VALUE>O obai a kiu nae a beera kurus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann139" ANNOTATION_REF="ann138">
                <ANNOTATION_VALUE>O kara obai eve to paku riori bona sia bara na paku rori bona teevoro ae o teebana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann142" ANNOTATION_REF="ann141">
                <ANNOTATION_VALUE>O kara obai eve mee to kisi ni riori bona inu bara tea vaave me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann145" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>O kara obai kou o kara kikis kurus. Na hiri nana teo kasuana, ore paa abe hiava teo naono.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann148" ANNOTATION_REF="ann147">
                <ANNOTATION_VALUE>O paka obai na toutou nana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann151" ANNOTATION_REF="ann150">
                <ANNOTATION_VALUE>KARA OROVI</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann154" ANNOTATION_REF="ann153">
                <ANNOTATION_VALUE>O kara orovi na kurus maa raara teo veresun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann157" ANNOTATION_REF="ann156">
                <ANNOTATION_VALUE>O veresun bona o paru na dao raara bono orovi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann160" ANNOTATION_REF="ann159">
                <ANNOTATION_VALUE>Are paa dee voosu mae,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann163" ANNOTATION_REF="ann162">
                <ANNOTATION_VALUE>are paa ma kahu e bona kehaa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann166" ANNOTATION_REF="ann165">
                <ANNOTATION_VALUE>Kahu vakavara</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann169" ANNOTATION_REF="ann168">
                <ANNOTATION_VALUE>are paa varoava e, ore raka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann172" ANNOTATION_REF="ann171">
                <ANNOTATION_VALUE>Be raka, are paa rigunue,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann175" ANNOTATION_REF="ann174">
                <ANNOTATION_VALUE>matatopo vaa tea vin maata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann178" ANNOTATION_REF="ann177">
                <ANNOTATION_VALUE>Are paa oroorovi nio orovi bona teo vonaha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann181" ANNOTATION_REF="ann180">
                <ANNOTATION_VALUE>KARA PIHI</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann184" ANNOTATION_REF="ann183">
                <ANNOTATION_VALUE>O Kara Pihi o meho subui vaa komana vaan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann187" ANNOTATION_REF="ann186">
                <ANNOTATION_VALUE>O hena kara pihi na tei me nana bona, ei to kao vo nae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann190" ANNOTATION_REF="ann189">
                <ANNOTATION_VALUE>Bean kara e, saka manin takara kurus haa maana, ore antee bean pihi komana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann193" ANNOTATION_REF="ann192">
                <ANNOTATION_VALUE>KARA ROVIVI</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann196" ANNOTATION_REF="ann195">
                <ANNOTATION_VALUE>O kara rovivi na tei me nana bono marasin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann199" ANNOTATION_REF="ann198">
                <ANNOTATION_VALUE>Bean kiu bata nom, ean re mosi vohara a mooman,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann202" ANNOTATION_REF="ann201">
                <ANNOTATION_VALUE>ean toro gono o kara rovivi,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann205" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>ean re buhaha e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann208" ANNOTATION_REF="ann207">
                <ANNOTATION_VALUE>Ean repaa posie bona mosi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann211" ANNOTATION_REF="ann210">
                <ANNOTATION_VALUE>Omana a vihii a beera,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann214" ANNOTATION_REF="ann213">
                <ANNOTATION_VALUE>evehee pasi too vaha koana a mosi tean.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann217" ANNOTATION_REF="ann216">
                <ANNOTATION_VALUE>Eve a taba to mataa suku nae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann220" ANNOTATION_REF="ann219">
                <ANNOTATION_VALUE>O hum to hata kaakoo nana o kara rovivi, bean mosie, ore paa sapusaka vo tea maa mataman.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann223" ANNOTATION_REF="ann222">
                <ANNOTATION_VALUE>O kara rovivi mee saka kikis haana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann226" ANNOTATION_REF="ann225">
                <ANNOTATION_VALUE>KARA RAVIANA</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann229" ANNOTATION_REF="ann228">
                <ANNOTATION_VALUE>O kara raviana eve o kara korisi to pampam sinivi ni riori.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann232" ANNOTATION_REF="ann231">
                <ANNOTATION_VALUE>Nabunuu komana vai roho suguna vai nomana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann235" ANNOTATION_REF="ann234">
                <ANNOTATION_VALUE>O kara koris bona o kara kikis kurus,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann238" ANNOTATION_REF="ann237">
                <ANNOTATION_VALUE>ei to rake suku riori tea pam sinivi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann241" ANNOTATION_REF="ann240">
                <ANNOTATION_VALUE>KARA RUHU</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann244" ANNOTATION_REF="ann243">
                <ANNOTATION_VALUE>O ruhu eve o meho naono to sun nana rasuu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann247" ANNOTATION_REF="ann246">
                <ANNOTATION_VALUE>O naono bona o beera sana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann250" ANNOTATION_REF="ann249">
                <ANNOTATION_VALUE>Eve he o kara berobero.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann253" ANNOTATION_REF="ann252">
                <ANNOTATION_VALUE>O kara nae na ikuu gunaha taneo maana gina tea maa pea nae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann256" ANNOTATION_REF="ann255">
                <ANNOTATION_VALUE>O kara ruhu na topo nana gina ore paa hana gunaha maana vo putaa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann259" ANNOTATION_REF="ann258">
                <ANNOTATION_VALUE>O ana ruhu mee na tei me nana bono porete vaa tea kamis nihi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann262" ANNOTATION_REF="ann261">
                <ANNOTATION_VALUE>Koto vamuramuraka o sii ana ruhu vai o sii rutaa, ean repaa vaatei e teo hum takepo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann265" ANNOTATION_REF="ann264">
                <ANNOTATION_VALUE>KARA URISI</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann268" ANNOTATION_REF="ann267">
                <ANNOTATION_VALUE>O kara urisi eve to vateen ni raara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann271" ANNOTATION_REF="ann270">
                <ANNOTATION_VALUE>Eara na gono rara o urisi teo veresun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann274" ANNOTATION_REF="ann273">
                <ANNOTATION_VALUE>A veresun na tei rori rasuu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann277" ANNOTATION_REF="ann276">
                <ANNOTATION_VALUE>Eara na kakapa rara o veresun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann280" ANNOTATION_REF="ann279">
                <ANNOTATION_VALUE>Are paa varoava e ore mahaka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann283" ANNOTATION_REF="ann282">
                <ANNOTATION_VALUE>Be mahaka eara re garuhu e ei beara viru bata rae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann286" ANNOTATION_REF="ann285">
                <ANNOTATION_VALUE>Mahaka vai ei, eara repaa gono tea vateen nie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann289" ANNOTATION_REF="ann288">
                <ANNOTATION_VALUE>KARA VUNEVUNE</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann292" ANNOTATION_REF="ann291">
                <ANNOTATION_VALUE>O vunevune o kara korisi to hirihiri batana teo kasuana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann295" ANNOTATION_REF="ann294">
                <ANNOTATION_VALUE>A vuuaba to vaahito rori teo kara vunevune a Nao Boen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="f" PARENT_REF="ref" PARTICIPANT="unknown" TIER_ID="free transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>THE WEED CALLED AISI</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann5" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>The aisi is a string-like plant that is creeping on the beaches of Hanatana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>This aisi is found on the ground.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE> Actually, it does not have any use for us.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>ARIONO VINE</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann17" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>The ariono vine is a good vine.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>It is used by the men for fishing in the sea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>When they go (fishing) in the sea, they must get the ariono string for kite-fishing.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>(They) do the kite fishing with the ariono string.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann29" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>GRASS</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>Grass is the food of cows.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>In the past we did not have any grass.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>But the cows came and they planted the grass for them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann41" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>And the road builders brought it here along the coast.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>And so (it) spead out here.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>An today our gardens are full of grass.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>Net vine</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann53" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>The net vine is a vine that has a very important function.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann56" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>In the past when there was not any net vine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>we could not eat any fish..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann62" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>Because (it was) the net vine from which they made the string,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann65" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>and then they made the net for fishing from it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann68" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>VINE (generic term)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>The kara koris is a string-like plant.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann74" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>This vine also grows in the jungle, in the garden.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann77" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>The vine we use for soup, we call it kara koremana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann80" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>When a woman gives birth, they give her the koremana vine to drink as soup, if the woman's breasts are empty,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>so that her breasts become full.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann86" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>This bunch of vines is a vegetable.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann89" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>It is a good vegetable.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann92" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>"Drink  this vine as a soup."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann95" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>PASSIONFLOWER</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann98" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>The passionflower is a vine that is found in the garden.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann101" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>The passionflower bears fruit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann104" ANNOTATION_REF="ann102">
                <ANNOTATION_VALUE>When its fruit matures, it becomes orange,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>this (means) that it is ripe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann110" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>"I want to eat a passionflower fruit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann113" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>The passionflower fruit is a very good fruit."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann119" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>The passionflower is found in the jungle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann122" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>It is creeping at the head of our garden.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann125" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>When it bears a fruit, they hang on its vines.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann128" ANNOTATION_REF="ann126">
                <ANNOTATION_VALUE>When it ripens, it becomes orange.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann131" ANNOTATION_REF="ann129">
                <ANNOTATION_VALUE>The fruit of the passionflower is very good.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann134" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>CALAMUS CANE; SWEET FLAG</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann137" ANNOTATION_REF="ann135">
                <ANNOTATION_VALUE>The calamus has very important uses.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann140" ANNOTATION_REF="ann138">
                <ANNOTATION_VALUE>The calamus cane is used for making chairs, and also used to make tables and beds.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann143" ANNOTATION_REF="ann141">
                <ANNOTATION_VALUE>The calamus cane is also used for lashing (the post and beams of) the house and also for thatching (the roof).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann146" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>The calamus cane is very strong. It creeps on the ground and then it creeps up a tree.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann149" ANNOTATION_REF="ann147">
                <ANNOTATION_VALUE>The calamus leaf is prickly.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann152" ANNOTATION_REF="ann150">
                <ANNOTATION_VALUE>Black sheath of the wild banana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann155" ANNOTATION_REF="ann153">
                <ANNOTATION_VALUE>The black wild banana sheath we cut off the wild banana plant.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann158" ANNOTATION_REF="ann156">
                <ANNOTATION_VALUE>This wild banana plant (with) black (leaf sheaths), we call orovi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann161" ANNOTATION_REF="ann159">
                <ANNOTATION_VALUE>(When we have cut off a black sheath,) we carry it home,  </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann164" ANNOTATION_REF="ann162">
                <ANNOTATION_VALUE>and scrape it with a shell.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann167" ANNOTATION_REF="ann165">
                <ANNOTATION_VALUE>After having scraped (it),</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann170" ANNOTATION_REF="ann168">
                <ANNOTATION_VALUE>we put it in the sun so that it becomes dry.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann173" ANNOTATION_REF="ann171">
                <ANNOTATION_VALUE>When it is dry, we roll it up,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann176" ANNOTATION_REF="ann174">
                <ANNOTATION_VALUE>in preparation for plaiting mats.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann179" ANNOTATION_REF="ann177">
                <ANNOTATION_VALUE>Then we plait this black sheath into a pandanus mat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann182" ANNOTATION_REF="ann180">
                <ANNOTATION_VALUE>FARTING WEED</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann185" ANNOTATION_REF="ann183">
                <ANNOTATION_VALUE>The Farting Weed is a weed in the village.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann188" ANNOTATION_REF="ann186">
                <ANNOTATION_VALUE>The name Farting Weed has been given to it for the following reason. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann191" ANNOTATION_REF="ann189">
                <ANNOTATION_VALUE>When you (try to) uproot it, it won’t get uprooted, until you fart.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann194" ANNOTATION_REF="ann192">
                <ANNOTATION_VALUE>ROVIVI, a kind of sappy vine</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann197" ANNOTATION_REF="ann195">
                <ANNOTATION_VALUE>The rovivi vine contains medicine.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann200" ANNOTATION_REF="ann198">
                <ANNOTATION_VALUE>When you work and accidentally cut your leg,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann203" ANNOTATION_REF="ann201">
                <ANNOTATION_VALUE>you must get a rovivi vine,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann206" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>then rub it into pulp in your hands.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann209" ANNOTATION_REF="ann207">
                <ANNOTATION_VALUE>And then you squeeze it (the juice) out onto the cut.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann212" ANNOTATION_REF="ann210">
                <ANNOTATION_VALUE>Sure, the stinging pain is great,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann215" ANNOTATION_REF="ann213">
                <ANNOTATION_VALUE>but your cut will heal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann218" ANNOTATION_REF="ann216">
                <ANNOTATION_VALUE>That's why it is good.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann221" ANNOTATION_REF="ann219">
                <ANNOTATION_VALUE>A situation in which the rovivi is bad is when you cut it, and the liquid splashes into your eyes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann224" ANNOTATION_REF="ann222">
                <ANNOTATION_VALUE>Also, the rovivi vine is not strong.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann227" ANNOTATION_REF="ann225">
                <ANNOTATION_VALUE>RAVIANA VINE</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann230" ANNOTATION_REF="ann228">
                <ANNOTATION_VALUE>The raviana is a vine that they use to tie up the canoe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann233" ANNOTATION_REF="ann231">
                <ANNOTATION_VALUE>In the past until today.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann236" ANNOTATION_REF="ann234">
                <ANNOTATION_VALUE>This vine is very strong,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann239" ANNOTATION_REF="ann237">
                <ANNOTATION_VALUE>this is why they want it for tying up canoes.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann242" ANNOTATION_REF="ann240">
                <ANNOTATION_VALUE>AERIAL ROOTS OF THE BENGAL FICUS	</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann245" ANNOTATION_REF="ann243">
                <ANNOTATION_VALUE>The Bengal ficus is a tree that stands in the jungle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann248" ANNOTATION_REF="ann246">
                <ANNOTATION_VALUE>This tree is very big.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann251" ANNOTATION_REF="ann249">
                <ANNOTATION_VALUE>Its has many aerial roots.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann254" ANNOTATION_REF="ann252">
                <ANNOTATION_VALUE>Its aerial roots hang down from its branches high up.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann257" ANNOTATION_REF="ann255">
                <ANNOTATION_VALUE>The aerial roots of the Bengal ficus stick there high up (in the tree) and hang down to the ground.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann260" ANNOTATION_REF="ann258">
                <ANNOTATION_VALUE>The root of the Bengal ficus contains medicine against tooth ache.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann263" ANNOTATION_REF="ann261">
                <ANNOTATION_VALUE>Bite off and soften a little piece of the Bengal ficus root, then you put it on the place (where a piece of the tooth) split off.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann266" ANNOTATION_REF="ann264">
                <ANNOTATION_VALUE>WILD BANANA SHEATH STRAP</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann269" ANNOTATION_REF="ann267">
                <ANNOTATION_VALUE>The wild banana sheath  we use (as a strap) for carrying the backpack.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann272" ANNOTATION_REF="ann270">
                <ANNOTATION_VALUE>We get the sheath from the wild banana plant.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann275" ANNOTATION_REF="ann273">
                <ANNOTATION_VALUE>The wild banana plants are in the jungle</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann278" ANNOTATION_REF="ann276">
                <ANNOTATION_VALUE>We pull (the sheath) off the wild banana plant.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann281" ANNOTATION_REF="ann279">
                <ANNOTATION_VALUE>Then we put it in the sun, so that it becomes dry.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann284" ANNOTATION_REF="ann282">
                <ANNOTATION_VALUE>When it is dry, we wash it, that is when we roll it up.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann287" ANNOTATION_REF="ann285">
                <ANNOTATION_VALUE> (When It) is dry now, we get it for carrying the backpack..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann290" ANNOTATION_REF="ann288">
                <ANNOTATION_VALUE>BEACH MORNING GLORY</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann293" ANNOTATION_REF="ann291">
                <ANNOTATION_VALUE>The Beach Morning Glory is a vine that crawls along on the ground.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann296" ANNOTATION_REF="ann294">
                <ANNOTATION_VALUE>The clan who owns the vunevune is the Nao Boen.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
