    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="Enoch Horai Magum" TIER_ID="text">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>A takinima eve a peha taba to tabotaboo vai niara nomanai en Teapu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>Eve he na paku raara bona koopu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>A kiu nae he na paku vonaen:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>Eara na tagihu rara rasuu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann13" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>ei kou a koopu sa teitei vira bata haana kasuana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>A koopu vai a mataa ae bebeahu na teitei nana rasuu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>Beara tagihu ei to sun nae a koopu,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>eara toro siisira rakaha roho a koopu eara repaa mosi mana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann25" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>O koopu toro mosi ara toro manoto bara toro mahaka rakaha mee.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>Eara sa antee haara tea mosi o koopu vai o kobus</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>tabae na antee nana tea koava ge mahamahan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>beara takinima nie</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann37" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>ei be raka bata maa a koopu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>Beara siisira vakavara, eara repaa mosi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>Are mosi vaantee a inu, eara repaa paku amaa dee.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>A peha dee kou na antee batana bono peho saavun koopu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann49" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>Kavara vai, eara dee voosu vo vaan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>Ei vaan to kahi paku pete raara o hum vaa tea kopakopaa a koopu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>Beara kopakopaa vakavara, eara repaa paku pete o hum vaa tea tasu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann58" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>A tasu ei beara tasu sirisiri bata rara a koopu, ore tamee teo vuri beara takitakinima batara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann61" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>Tea tasu he eara na tasu rara a koopu bona toraara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann64" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>Be kavara a kiu vaa tea tasu, eara repaa taatagi o komano koopu -</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>ei eara na taraha vatotobin bata koara amaa nava nae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann70" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>Ei to mene ato vakisi bata ni nana bono koopu teo vuri vaa tea takitakinima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann73" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>Beara taatagi vakavara a koopu, eara nao vai tea kiu vaa tea takitakinima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann76" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>Tea takitakinima he na tei me nana bono buaku o kaku hanana vaa tea paku takinima.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>O peho o vavaasun, o meho he o vavaagoroho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann82" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>Teo vavaasun, eara na ipinoo rara a sun hiava bara a tatabonata na inu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann85" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>Eara repaa kurukurus a koopu vai to paa tasu vaevuru ara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann88" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>Be kavara o hum bona, eara repaa vavaasun nao a koopu, ore no suguna komana teo vagegeana na taboo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>Eara repaa taneo tea hogohogo ni nao a koopu vaantee tea tatabonata na taboo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann94" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>Beara hogo, eara na gae rara a ta kukan, eara repaa hogo tavusu nie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann97" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>Eara repaa taono a ta meha a ta kukan, eara repaa gae vaha bana a ta meha ta kukan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann100" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>Eara paku bata koa vo nao raen ore poosu komana a taboo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann102">
                <ANNOTATION_VALUE>Teo vavaagoroho he na vaapeha koana, amaa hogo ae a gae kukan. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann106" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>Evehee ei kou eara sa paku haara to ipinoo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann109" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>Eara na vaagoroho rara a ta kukan ge a ta taonim,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann112" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>eara repaa taneo kou tea hogo ae gae, ore suguna komana bea taboo poosu vakavara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann115" ANNOTATION_REF="ann114">
                <ANNOTATION_VALUE>Ahiki to ipinoo, eikou eara na ponuu kaakoo bata koara a koopu beara hogo vaantee bata naora a taboo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="ref" PARTICIPANT="unknown" TIER_ID="free transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>Plaited bamboo is a thing that we use today for making walls here in the Teop region.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann5" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>We make it from koopu bamboos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>The work on it is done as follows::</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>We go into the jungle</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>because there are not many koopu bamboos along the coast.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann17" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>The good and long koopu bamboos grow in the jungle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>When we go into the jungle where the koopu bamboos stand,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>we must intensively examine the koopu bamboos, before we eventually cut them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>The koopu bamboo that we should cut must be mature and also must be very dry.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann29" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>We cannot cut the moist koopu bamboo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>because it can rot or leave spaces,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>when we plait the bamboo wall with it,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>that is when the koopu bamboos dry up.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann41" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>When we have finished examining (them), we cut (them).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>Then we cut as many as are needed for the house, and then we make the loads (to carry the bamboo home).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>One load consists of ten koopu bamboos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>After that we carry (them) home to the village.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann53" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>It is here in the village where we will do the next part o work, the lengthwise cutting of the koopu bamboos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann56" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>When we have cut (them) lengthwise, we do the next part of (work), the beating (of the bamboo).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>This beating (means) that we beat (and) split the koopu bamboo strips, so that they are flexible when we are plaiting the bamboo wall.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann62" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>As for the beating, we beat the koopu bamboos with an axe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann65" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>When the work of the beating is finished, we prepare the inside of the bamboos. (lit. the insides of the bamboo)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann68" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>this (means that) we shave (and) make its bars even,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>This is to prevent the bamboo from getting stuck (at the knots) when the plaiting is done. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann74" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>When we have prepared the bamboos, we proceed with the work of the bamboo-plaiting.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann77" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>As for the bamboo-plaiting, there are two kinds of pattern of making plaited bamboo walls.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann80" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>One is the make-stand-up pattern, the other one the make-asleep pattern.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>As for the make-stand-up pattern, we measure the height and the width of the house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann86" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>Then we cut the bamboos that we have already beaten (into strips).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann89" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>When this part is finished, we make the bamboo strips stand up, until the ends of the wall are reached.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann92" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>Then we start pushing the (horizontal) bamboo strips (in between the vertical ones), until it is enough for the width of the wall.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann95" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>When we push (bamboo strips), we lift three (vertical) strips, then we push them (the horizontal ones) through.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann98" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>Then we put three other strips on top, and then we lift three strips again.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann101" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>We just do it like this until the wall is completely closed.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann104" ANNOTATION_REF="ann102">
                <ANNOTATION_VALUE>With the make-asleep pattern it is just the same, some pushing and the lifting of three (strips).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>But now we do not do any measurement.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann110" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>We  lay three or five strips down,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann113" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>then we start pushing and lifting (the strips) until the wall is completely closed. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann116" ANNOTATION_REF="ann114">
                <ANNOTATION_VALUE>There is not any measure, because we just bend and move the bamboo strips along, when we are pushing (them) to the (end of the) wall.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
