    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="free transl." PARTICIPANT="unknown" TIER_ID="lit. transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1538" ANNOTATION_REF="ann5">
                <ANNOTATION_VALUE>(lit. This tree, the sago palm, they plant it themselves.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1528" ANNOTATION_REF="ann8">
                <ANNOTATION_VALUE>(lit. Because this tree, it (is) what they thatch their houses with.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1539" ANNOTATION_REF="ann11">
                <ANNOTATION_VALUE>(lit. Also, the sago palm, when it bears fruit, ...)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1530" ANNOTATION_REF="ann26">
                <ANNOTATION_VALUE>(lit. the bone in the middle)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1532" ANNOTATION_REF="ann32">
                <ANNOTATION_VALUE>(lit. When you have completely stacked up, ...)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1540" ANNOTATION_REF="ann71">
                <ANNOTATION_VALUE></ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1541" ANNOTATION_REF="ann74">
                <ANNOTATION_VALUE></ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1529" ANNOTATION_REF="ann95">
                <ANNOTATION_VALUE>(lit. But when they have not  done yet the thatching, (they) must pull calamus cane hither before.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1531" ANNOTATION_REF="ann119">
                <ANNOTATION_VALUE>(lit. when  another three give the thatch sheets upwards)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1535" ANNOTATION_REF="ann122">
                <ANNOTATION_VALUE>(lit. The four people on top (are) who will tie the thatch sheets ...)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
