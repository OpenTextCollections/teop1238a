    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="Naphtali Maion" TIER_ID="text">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>A kakavei</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>VAAMATATOPO NA MAA TABA</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>Momohu kona nia kave tabae tau paku an, a kave a beera ge a rutaa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>Beo hum bona kavara, erau ean antee vai tea kaokao a maamihu taba na kakavei tean.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann13" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>Kona ni amaa humhum na kakavei.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>A hena na maa taba paku na kakavei:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>1. koverau (baoru) - 2</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>2. kapikapis - 8</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann25" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>3. kara raviana - 6</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>4. toorana (naono) - 2</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>5. sunsun (miimiana) - 2</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>6. kara baneo ge kave - bero</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann37" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>7. tavara (kururu) - 1</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>8. hihiana (o koverau o rutaa)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>Bean tau paku a kakavei,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>evei amaa taba toro vaamatatopo an.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann49" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>(1) O buaku o koverau mene o buo baoru</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>Mosi amaa koverau vai amaa manoto vamataa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>Vaaraka vamatai tea roava.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann58" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>Taraha taatagi amaa koverau bona.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann61" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>(2) O buaku o toorana toro mosi maa. Vaarakai tea roava.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann64" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>(3) Mosi maa o mimiana mene o buaku o sunsun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>Vaarakai mee tea roava.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann70" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>(4) Mosi a vahara baneo, kahu a kapa nae, vaatei tea roava ore raka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann73" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>Be raka, hihi a kara nae mene paku bona kanono.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann76" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>Bean rake, ean repaa kurus kara kave maa rasuu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>Vaarakai tea roava, ean repaa kahue bona kehaa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann82" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>Ean repaa paku a kanono mene huha bona kakavei.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann85" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>(5) Tasu varaba maa a raviana rasuu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann88" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>Vaarakai tea roava bean siri kopaa varaba batae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>(6) O kapikapis: Amaa ta naono vaarii na taraha vakavara raara mene kapis bona maa pampam na kakavei.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann94" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>Taraha vaantee eta kukan totoka to antee nana bona a buaku a kakavei.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann97" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>(7) Vaamatatopo varaba a tavara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann100" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>(8) Vaamatatopo varaba o koverau o rutaa mene o hihiana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann102">
                <ANNOTATION_VALUE>Vaamatatopo a kanono</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann106" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>O hum kiu vai na beera oha vareko nana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann109" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>Ean kahi tagihu nom rasuu tea kurus kave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann112" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>O kave na abeabe batana tea naono, saka tei vananaoana vira haana me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann115" ANNOTATION_REF="ann114">
                <ANNOTATION_VALUE>Bean suguna koa to abe vaberobero riori,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann118" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>ean repaa saku koa tea kurus, ean repaa voosu vahaa koa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann121" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>Bean voosu me amaa dee kave, pasi vaobete roho noman,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann124" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>eve re meapa roho.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann127" ANNOTATION_REF="ann126">
                <ANNOTATION_VALUE>Beve meapa, ean repaa hihi manae,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann130" ANNOTATION_REF="ann129">
                <ANNOTATION_VALUE>ean repaa kahu batae mee.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann133" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>Bean kahu vakavarae,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann136" ANNOTATION_REF="ann135">
                <ANNOTATION_VALUE>ean repaa varoava e ore raka</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann139" ANNOTATION_REF="ann138">
                <ANNOTATION_VALUE>Be raka vamataa, ean repaa viru a kanono tean.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann142" ANNOTATION_REF="ann141">
                <ANNOTATION_VALUE>A kanono bona to kahi huha noman bona kakavei tean.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann145" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>A kanono toro antee bona buaku a kakavei a bua vapara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann148" ANNOTATION_REF="ann147">
                <ANNOTATION_VALUE>HUHA KAKAVEI</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann151" ANNOTATION_REF="ann150">
                <ANNOTATION_VALUE>Bea maa taba vai matatopo, ean antee vai tea huha a kave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann154" ANNOTATION_REF="ann153">
                <ANNOTATION_VALUE>A taba to pasi paku noman, ei a kanono vai to kahi huha noman bona buaku a kave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann157" ANNOTATION_REF="ann156">
                <ANNOTATION_VALUE>A kanono bona pasi vaabebeahu kurus noman ore antee bona buaku a kave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann160" ANNOTATION_REF="ann159">
                <ANNOTATION_VALUE>A meha kanono to kahi paku noman, ei a roveana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann163" ANNOTATION_REF="ann162">
                <ANNOTATION_VALUE>A roveana eve a kanono to taviri vakavara nana bona kave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann166" ANNOTATION_REF="ann165">
                <ANNOTATION_VALUE>A kanono bona ge a roveana to rahi parata nana bona kave teo vuri to nove noman a kakavei.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann169" ANNOTATION_REF="ann168">
                <ANNOTATION_VALUE>Bea bua kanono vai kavara, ean matatopo vai tea paku a sinoo na kave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann172" ANNOTATION_REF="ann171">
                <ANNOTATION_VALUE>A kanono tean a matatopo,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann175" ANNOTATION_REF="ann174">
                <ANNOTATION_VALUE>ean viru vai a kanono tea hihiana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann178" ANNOTATION_REF="ann177">
                <ANNOTATION_VALUE>Ean gono vai a tavara,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann181" ANNOTATION_REF="ann180">
                <ANNOTATION_VALUE>O SINOO NA KAVE: vatotomo na maa humhum na kakavei</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann184" ANNOTATION_REF="ann183">
                <ANNOTATION_VALUE>A maamihu taba paa vaamatatopo vaevuru, a kakavei kahi vatotomo raarai.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann187" ANNOTATION_REF="ann186">
                <ANNOTATION_VALUE>(1) Gono o toorana bara  o sunsun, pampam vabuaku ri bona kara raviana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann190" ANNOTATION_REF="ann189">
                <ANNOTATION_VALUE>(2) Gono o baoru, pam mi nai bono pasu no toorana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann193" ANNOTATION_REF="ann192">
                <ANNOTATION_VALUE>Pam i bona kara raviana (a buaku a pam).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann196" ANNOTATION_REF="ann195">
                <ANNOTATION_VALUE>(3) Tasu vakikis amaa pampam bona maa kapikapis.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann199" ANNOTATION_REF="ann198">
                <ANNOTATION_VALUE>Teo peho sinoo tapa ni o dorana o hum.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann202" ANNOTATION_REF="ann201">
                <ANNOTATION_VALUE>Be kavara, o sinoo paa matatopo vaevuru.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann205" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>(4) Nove a kakavei.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann208" ANNOTATION_REF="ann207">
                <ANNOTATION_VALUE>VURI NOVE NA KAKAVEI</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann211" ANNOTATION_REF="ann210">
                <ANNOTATION_VALUE>(1) Vakisi nio pasu kave teo pasu no baoru.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann214" ANNOTATION_REF="ann213">
                <ANNOTATION_VALUE>(2) Vakisi nio meho teo sunsun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann217" ANNOTATION_REF="ann216">
                <ANNOTATION_VALUE>(3) Vakisi nio meho pasu kave romuno baoru.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann220" ANNOTATION_REF="ann219">
                <ANNOTATION_VALUE>(4) Vakisi nio vakosina teo toorana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann223" ANNOTATION_REF="ann222">
                <ANNOTATION_VALUE>A kakavei paa taparata vamataa vaevuru.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann226" ANNOTATION_REF="ann225">
                <ANNOTATION_VALUE> Bean toku, tara teo vaa'abeabe na kakavei gina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="ref" PARTICIPANT="unknown" TIER_ID="free transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>The kakavei net.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann5" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>THE PREPARATION OF THE THINGS (you need to make a pair of kakavei nets):</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>First think about what kind of net you are going to make, a large net or a small one.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>When this part is finished, then you can go ahead with all the things of your kakavei.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>Think of the parts of the kakavei</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann17" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>The names of the things for making a kakavei net:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>Two bent koverau bamboos (for the frames of the pair of kakavei nets)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>Eight wedges (made of wood)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>Six strings made of raviana vines</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann29" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>Two short wooden poles to which the bamboo is tied.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>Two poles of miimiana palm wood to which the toorana is tied,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>Many strings made of fibres of the young breadfruit  tree or the net vine</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>A small rectangular piece of kururu bamboo (2 x 4 inches) that is used to measure the size of the meshes of the net</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann41" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>A net needle (made of a small piece of koverau bamboo)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>When you are about to make a kakavei,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>these are the things that you must prepare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>Two koverau bamboos for the bent bamboos of the two  frames</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann53" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>Cut fully matured koverau bamboos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann56" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>Let them thoroughly dry in the sun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>Carefully level the outside of these koverau bamboos (i.e. the knots).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann62" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>The two toorana must be cut. Let them dry in the sun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann65" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>Cut a miimiana palm for the two sunsun poles</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann68" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>Let it also dry in the sun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>Cut young breadfruit trees, scrape off the bark, put them into the sun to dry.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann74" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>When they are dry, pull itheir fibres off to make the string.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann77" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>If you want, you cut kave vines in the jungle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann80" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>Let them dry in the sun, and then you scrape them with a shell.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>Then you make the string for tying the kakavei net.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann86" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>Cut the raviana vines in advance.in the jungle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann89" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>Let them dry in the sun  after you have torn them (the fibres) lengthwise apart.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann92" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>The wedges: we carve all these pieces of wood to wedge them into the lashings of the kakavei net.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann95" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>Carve eight pieces which will be enough for two kakavei nets.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann98" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>Prepare the tavara (piece of wood for measuring the meshes of a net).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann101" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>Prepare a small piece of koverau bamboo for the net needle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann104" ANNOTATION_REF="ann102">
                <ANNOTATION_VALUE>Prepare the string.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>This part of the work is quite labour.intensive.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann110" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>You go into the jungle to cut net-vines.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann113" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>The kave-vine is creeping on the trees, it is also not very far away.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann116" ANNOTATION_REF="ann114">
                <ANNOTATION_VALUE>When you have arrived where they are creeping in large quantities,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann119" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>you just quickly cut them and then you go back home.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann122" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>When you come home with loads of net-vines, you first lay them down,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann125" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>so that they become flexible.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann128" ANNOTATION_REF="ann126">
                <ANNOTATION_VALUE>When they are flexible, you eventually remove the fibres from them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann131" ANNOTATION_REF="ann129">
                <ANNOTATION_VALUE>then you also scrape them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann134" ANNOTATION_REF="ann132">
                <ANNOTATION_VALUE>When you have completely scraped them,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann137" ANNOTATION_REF="ann135">
                <ANNOTATION_VALUE>you put them into the sun to dry.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann140" ANNOTATION_REF="ann138">
                <ANNOTATION_VALUE>When they have dried up well, you twist your string.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann143" ANNOTATION_REF="ann141">
                <ANNOTATION_VALUE>This string (is the one) that you are going to tie your kakavei net with.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann146" ANNOTATION_REF="ann144">
                <ANNOTATION_VALUE>The string must be (long) enough for the pair of kakavei-nets (lit. two kakavei-nets, two partners).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann149" ANNOTATION_REF="ann147">
                <ANNOTATION_VALUE>TIE KAKAVEI NETS</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann152" ANNOTATION_REF="ann150">
                <ANNOTATION_VALUE>When these things are prepared, you can now tie the net.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann155" ANNOTATION_REF="ann153">
                <ANNOTATION_VALUE>The thing that you will make, this is the string that you use for tying the two nets.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann158" ANNOTATION_REF="ann156">
                <ANNOTATION_VALUE>You will make this string very long so that it is long enough for the two nets.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann161" ANNOTATION_REF="ann159">
                <ANNOTATION_VALUE>Another string that you'll make is the roveana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann164" ANNOTATION_REF="ann162">
                <ANNOTATION_VALUE>The roveana is the string that surrounds the whole net (as a seam).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann167" ANNOTATION_REF="ann165">
                <ANNOTATION_VALUE>This string or roveana pulls the net open when you tie it to the kakavei frame.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann170" ANNOTATION_REF="ann168">
                <ANNOTATION_VALUE>When the two strings are finished, you are prepared to make the frame of the net.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann173" ANNOTATION_REF="ann171">
                <ANNOTATION_VALUE>Your string is prepared,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann176" ANNOTATION_REF="ann174">
                <ANNOTATION_VALUE>you  now wind the string now around the net needle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann179" ANNOTATION_REF="ann177">
                <ANNOTATION_VALUE>You get the tavara (to measure the size of the meshes).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann182" ANNOTATION_REF="ann180">
                <ANNOTATION_VALUE>THE FRAME OF THE NET: putting the parts of the kakavei together</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann185" ANNOTATION_REF="ann183">
                <ANNOTATION_VALUE>Everything is aready prepared, we will put the kakavei together now.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann188" ANNOTATION_REF="ann186">
                <ANNOTATION_VALUE>(1) Get the toorana pole and the sunsun pole, tie them together with two lashings of the raviana strings.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann191" ANNOTATION_REF="ann189">
                <ANNOTATION_VALUE>(2) Get a bamboo pole, lash it together with the end of the torana-pole.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann194" ANNOTATION_REF="ann192">
                <ANNOTATION_VALUE>Lash them together with the raviana strings (two lashings).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann197" ANNOTATION_REF="ann195">
                <ANNOTATION_VALUE>Firmly tighten the lashings with the wedges.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann200" ANNOTATION_REF="ann198">
                <ANNOTATION_VALUE>Drive four pieces (i.e. wedges) into the lashings of one frame.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann203" ANNOTATION_REF="ann201">
                <ANNOTATION_VALUE>When it is finished, the frame is already prepared.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann206" ANNOTATION_REF="ann204">
                <ANNOTATION_VALUE>Tie the net to the kakavei frame.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann209" ANNOTATION_REF="ann207">
                <ANNOTATION_VALUE>Steps of  tying the kakavei net to its frame</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann212" ANNOTATION_REF="ann210">
                <ANNOTATION_VALUE>(1) Tie an edge of the net to the end of the bamboo pole.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann215" ANNOTATION_REF="ann213">
                <ANNOTATION_VALUE>(2) Tie another (edge) to the sunsun</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann218" ANNOTATION_REF="ann216">
                <ANNOTATION_VALUE>(3) Tie the third edge of the net to the middle of the bamboo pole.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann221" ANNOTATION_REF="ann219">
                <ANNOTATION_VALUE>(4) Tie the end of net to the toorana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann224" ANNOTATION_REF="ann222">
                <ANNOTATION_VALUE>The kakavei has now already properly unfolded.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann227" ANNOTATION_REF="ann225">
                <ANNOTATION_VALUE>If you do not understand it, look at the picture of the kakavei above.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="word division" PARENT_REF="text" PARTICIPANT="unknown" TIER_ID="words">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a793" ANNOTATION_REF="ann1">
                <ANNOTATION_VALUE>A</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
