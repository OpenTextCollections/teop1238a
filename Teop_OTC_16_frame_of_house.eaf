    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="Enoch Horai Magum" TIER_ID="text">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>Amaa humhum na inu gorogoroho vaa Teapu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>TOON</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>A ta naono vai a ta beera, bebeahu ae kikis to toon riori bona inu,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>ge eve o naono to dee maana bona inu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann13" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>Bea ta tovihi, na tei koana tea beera na inu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>Evehee sa gonogono vahogo haari,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>ahiki, o naono to mataa ki nana bono toon o toraha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>O naono o kikis ae o vaanagu koava.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann25" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>PAEE</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>O naono o bebeahu to vaobete riori toon na maa paos.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>Evehee toro naono vai haabana o kikis, tabae eve to kahi dee nana bono paranda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>A ta tovihi? Na tei koana tea bero tea toon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann37" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>O hum to teitei bata nae mee ei toon na maa sunsun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>SUNSUN</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>O sunsun o naono to sun nana toon na maa paee,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>O meho paee repaa obete taono vaha ni maa bona,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann49" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>O varuvaru repaa obete maa toon nae.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>Eve o naono to kahi ato ni nana bono hum inu vaa gina</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>GAASUU</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann58" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>O gaasuu o naono to vavaasun riori tobina inu toon no paee.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann61" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>Beo tovihi? Na tei koana tea bebeahu na inu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann64" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>Evehee a kiu tea maa naono bari mene dee</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>ge eve to vaatoka maa riori bono peho paee.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann70" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>Amaa ta naono bari mee amaa ta kakato koa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann73" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>VARUVARU</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann76" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>A varuvaru eve a naono to kahi vaobete mau ori toon no paee vai</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>to paa vaobete vori toon na mata gaasuu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann82" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>Eve mee a naono to kahi vaave taono riori bona atovo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann85" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>A bero nae mee na tei habana koana tea bebeahu na inu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann88" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>A naono nae a vahavahara naono vaa tea apao.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>A varuvaru he toro tapaku tea buaku a papana tea papa matau ae papa keruka</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann94" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>ore paa vatasu vatatana tobina toon no paee vai</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann97" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>to paa vaatoka vori toon na maa gaasuu vaa tobina.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann100" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>VAATETEKOIO</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann103" ANNOTATION_REF="ann102">
                <ANNOTATION_VALUE>O naono bebeahu to kahi vaatoka vaha maa riori toon na maa varuvaru vai to paa vatasu vatatana vuru.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann106" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>Eve to kahi ato vakikis habana nana tea inu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann109" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>Evehee a kiu teo naono bona rakaha, ei meno kovuaka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann112" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>Eve to kahi vaobete maa riori bono kovuaka ore paa obete vamataa koa maa teebona.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann115" ANNOTATION_REF="ann114">
                <ANNOTATION_VALUE>HOGO</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann118" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>O naono to hogo vaha ni maa riori paana, be obete bata maana toon na maa paee vai tea maa toon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann121" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>Eve to kahi obete mau o paranda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann124" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>O tovihi? Na tei pete koana tea bebeahu ae tea tatabonata na inu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="ref" PARTICIPANT="unknown" TIER_ID="free transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>Some parts of the Teop sleeping house</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann5" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>POST</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>A big, long and strong pole that is used as a post of the house,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>or, (put differently,) it is a pole that carries the house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>How many, (that) depends on the size of the house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann17" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>But they do not get them in a careless way,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>no, the tree that is good for a post is the New Guinea Teak.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>The wood is strong and resistant to rotting.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>HORIZONTAL BEAM (joist, tie beam, joist, and the main ridge pole)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann29" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>The long beam that is put on top of the posts.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>But (it) must again be a strong beam because it will carry the floor. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>How many? That just depends on the number of the posts.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>A place where they also lie, this is on top of the (posts called) sunsun ( standing posts).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann41" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>STANDING POST</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>The standing post is a pole that stands on the horizontal beams.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>And another horizontal beam lies on it,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>And then the rafter lies on top of it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann53" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>It is the pole that holds the upper part of the house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann56" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>KING POST</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>The gaasu is the pole that they stand in the middle of the house on top of the tie beam.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann62" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>How many? That just depends of the length of the house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann65" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>The function of these poles is to carry (the main ridge pole)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann68" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>or, (in other words,) it is the one on which they make the main ridge pole perch.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>These pieces of wood are quite short.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann74" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>RAFTER</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann77" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>The rafters are the beams that are laid on the horizontal beam</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann80" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>that is laid on to the kingposts.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>They are also the beams on which the sago palm thatches will be fixed.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann86" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>Their number also depends only on the length of the house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann89" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>The trees used for them are little trees from the old garden.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann92" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>The rafters must be made on the two sides, on the right side and the left side</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann95" ANNOTATION_REF="ann93">
                <ANNOTATION_VALUE>so that they touch each other in the middle (of the roof) on top of the horizontal beam</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann98" ANNOTATION_REF="ann96">
                <ANNOTATION_VALUE>that they have placed on the kingposts in the middle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann101" ANNOTATION_REF="ann99">
                <ANNOTATION_VALUE>Upper ridgepole</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann104" ANNOTATION_REF="ann102">
                <ANNOTATION_VALUE>A long beam that will be placed on top of the rafters that have touched each other (on the lower ridgepole).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann107" ANNOTATION_REF="ann105">
                <ANNOTATION_VALUE>It also will hold the house firmly together.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann110" ANNOTATION_REF="ann108">
                <ANNOTATION_VALUE>But the main function of this beam, this is for the top thatch sheet.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann113" ANNOTATION_REF="ann111">
                <ANNOTATION_VALUE>It is (the beam) where they will put the top thatch sheet so that it properly lies there.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann116" ANNOTATION_REF="ann114">
                <ANNOTATION_VALUE>FLOOR JOIST</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann119" ANNOTATION_REF="ann117">
                <ANNOTATION_VALUE>The beams that they put underneath (the floor), while they lie on the horizontal beams (that lie) on the posts.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann122" ANNOTATION_REF="ann120">
                <ANNOTATION_VALUE>They are the ones on which the floor will lie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann125" ANNOTATION_REF="ann123">
                <ANNOTATION_VALUE>How many? That also just depends on the length and the width of the house.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
