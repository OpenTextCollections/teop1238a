            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a14" ANNOTATION_REF="ann1" PREVIOUS_ANNOTATION="a13">
                <ANNOTATION_VALUE>Teapu</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
