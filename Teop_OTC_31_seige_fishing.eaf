    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="Enoch Horai Magum" TIER_ID="text">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann1" ANNOTATION_REF="ann0">
                <ANNOTATION_VALUE>O meho kaku vagana vaa tea kave en teara, a ta Teapu, na dao raara bono seige.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann4" ANNOTATION_REF="ann3">
                <ANNOTATION_VALUE>A vagana bona saka vaapenapena haana bea peha gea buaku ge bero aba nao tea nao vagana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>O kaku vagana bona he na paku vonaen:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>Eara na vaahae rara a kave, eara repaa hua vo tea maa hum to vavaasun kave komana raara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann13" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>Amaa hum bona he toro hum vai to gunagunaha kaakoo rio iana beve tarahi batana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>O kaku hum bona he eiei tea maa hoa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>Beara suguna, eara repaa busu nia kave, eara repaa rahi ge vaasun pina nie bona hanana teo iana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>Eara repaa pam nio buo punete na kave teo buo boon to paa vaasun vuara, eara he tea mei tea vaagunaha a kave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann25" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>Beve kavara, eara repaa vahakaa pina koa maara o iana to mene gunaha kaakoo teo meho hum.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>Bea tahii taneo bata mana tea tarahi, eove o vuri to kahi taneo hana rio iana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>Beori hana rori, eara na antee batara tea no ropusu kahi riori bona kave, ge be hiki, ei mana, beve tarahi vakavara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>Evehee, eara toro usu bata koa ni rara o iana vai o bebeera to mene buno kurukurus bona kave, a kave repaa taparata</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann37" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>O kaku vagana vai o mataa tabae eara sa hua binubinu haara tea rake ge vatevatete a iana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>Eara kahi sun ihuana koa nom beori hana rori tea kave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>Bea tahii masi vakavara, eara repaa voosu vahaa vaan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="text" PARTICIPANT="unknown" TIER_ID="free transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann2" ANNOTATION_REF="ann1">
                <ANNOTATION_VALUE>Another kind of fishing with a net here with us, the Teop people, is called seige.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann5" ANNOTATION_REF="ann4">
                <ANNOTATION_VALUE>This fishing allows one or two or many people to go fishing.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann7">
                <ANNOTATION_VALUE>This kind of fishing is done as follows:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann10">
                <ANNOTATION_VALUE>We take the net on board,, then we paddle to the places where we put up nets.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann13">
                <ANNOTATION_VALUE>These places must be places where the fish go when the tide is ebbing.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann17" ANNOTATION_REF="ann16">
                <ANNOTATION_VALUE>This kind of place is in the passages.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann19">
                <ANNOTATION_VALUE>When we arrive, we throw the net, then we pull it or put it up so that it blocks the way of the fish.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann22">
                <ANNOTATION_VALUE>Then we tie the two ends of the net to two mangrove poles that we have erected, before we let the net go down.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann25">
                <ANNOTATION_VALUE>After that, we beat the water to prevent the fish from going down to another place.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann29" ANNOTATION_REF="ann28">
                <ANNOTATION_VALUE>When the sea eventually starts ebbing, this is the time when the fish start hanging (in the net).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann31">
                <ANNOTATION_VALUE>When they are hanging (there), we can go (and) pull them out of the net, or if (they) don't, this eventually means that it is low tide.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann34">
                <ANNOTATION_VALUE>But we must watch the big fish that they do not move so much that the net gets opened.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann37">
                <ANNOTATION_VALUE>It is a good kind of fishing, because we do not paddle around to search for or chase the fish.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann41" ANNOTATION_REF="ann40">
                <ANNOTATION_VALUE>We would just stand still waiting for them to hang in the net.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann43">
                <ANNOTATION_VALUE>When the sea is at low tide, we go home back to the village.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
