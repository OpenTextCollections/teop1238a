    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="text" PARTICIPANT="unknown" TIER_ID="free transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1780" ANNOTATION_REF="ann1">
                <ANNOTATION_VALUE>TURTLE</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1781" ANNOTATION_REF="ann4">
                <ANNOTATION_VALUE>The turtle is a very big swimming animal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1782" ANNOTATION_REF="ann7">
                <ANNOTATION_VALUE>When you see it, you see:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1783" ANNOTATION_REF="ann10">
                <ANNOTATION_VALUE>The turtle has a head, (and) four flippers.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1784" ANNOTATION_REF="ann13">
                <ANNOTATION_VALUE>The shell on its back is hard, the shell on its chest is not hard.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1785" ANNOTATION_REF="ann16">
                <ANNOTATION_VALUE>As for the four flippers, the two flippers near its head, we call paddles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1786" ANNOTATION_REF="ann19">
                <ANNOTATION_VALUE>The turtle strongly paddles with these two flippers.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1787" ANNOTATION_REF="ann22">
                <ANNOTATION_VALUE>The two hind flippers it uses for steering and also for paddling.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1788" ANNOTATION_REF="ann25">
                <ANNOTATION_VALUE>The turtle also breathes when it comes out of the water, then it dives down again.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1789" ANNOTATION_REF="ann28">
                <ANNOTATION_VALUE>When the female turtle is about to lay eggs, it goes ashore to the white sand.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1790" ANNOTATION_REF="ann31">
                <ANNOTATION_VALUE>It digs a hole in the ground,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1791" ANNOTATION_REF="ann34">
                <ANNOTATION_VALUE>then it lays its eggs into the hole</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1792" ANNOTATION_REF="ann37">
                <ANNOTATION_VALUE>and fills the hole up again.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1793" ANNOTATION_REF="ann40">
                <ANNOTATION_VALUE>But when the turtle fills up the hole again, it becomes invisable,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1794" ANNOTATION_REF="ann43">
                <ANNOTATION_VALUE>so that one cannot quickly find it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1795" ANNOTATION_REF="ann46">
                <ANNOTATION_VALUE>The turtle lays very many eggs.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1796" ANNOTATION_REF="ann49">
                <ANNOTATION_VALUE>Must be more than fifty.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1797" ANNOTATION_REF="ann52">
                <ANNOTATION_VALUE>When someone goes diving for turtles, he goes straight to the edge of the reef.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1798" ANNOTATION_REF="ann55">
                <ANNOTATION_VALUE>The turtles stay at the edge of the reef in the caves of the rocks at the side of the ocean.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1799" ANNOTATION_REF="ann58">
                <ANNOTATION_VALUE>When the sea is at low tide (so that the reef is visable), then they can quickly find the turtles,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1800" ANNOTATION_REF="ann61">
                <ANNOTATION_VALUE>when they are eating vasukare corals and stay in the rock caves and in the turtle tunnels.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1801" ANNOTATION_REF="ann64">
                <ANNOTATION_VALUE>How they catch a turtle</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1802" ANNOTATION_REF="ann67">
                <ANNOTATION_VALUE>They get hold of the turtle with the net,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1803" ANNOTATION_REF="ann70">
                <ANNOTATION_VALUE>that is when they go turtle netting.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1804" ANNOTATION_REF="ann73">
                <ANNOTATION_VALUE>This net is very big.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1805" ANNOTATION_REF="ann76">
                <ANNOTATION_VALUE>It can catch twenty turtles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1806" ANNOTATION_REF="ann79">
                <ANNOTATION_VALUE>Sometimes they go diving for turles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1807" ANNOTATION_REF="ann82">
                <ANNOTATION_VALUE>They also catch a turtle when the turtle goes ashore to lay its eggs in the sand.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1808" ANNOTATION_REF="ann85">
                <ANNOTATION_VALUE>When they go fishing with torches, they also find the turtle when it gets trapped in the lagoons at low tide. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1809" ANNOTATION_REF="ann88">
                <ANNOTATION_VALUE>How turtles are butchered by the Teop people </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1810" ANNOTATION_REF="ann91">
                <ANNOTATION_VALUE>In former times the butchering of turtles was only done by the big men.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1811" ANNOTATION_REF="ann94">
                <ANNOTATION_VALUE>You could not see any child or any young man at the place where they were butchering turtles.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1812" ANNOTATION_REF="ann97">
                <ANNOTATION_VALUE>It was exclusively the work of the chiefs, it was like butchering pigs.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1813" ANNOTATION_REF="ann100">
                <ANNOTATION_VALUE>Today these practices have disappeared from us.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1814" ANNOTATION_REF="ann103">
                <ANNOTATION_VALUE>Today, when you are about to butcher a turtle - just do it; indeed, there is not any talk about it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1815" ANNOTATION_REF="ann106">
                <ANNOTATION_VALUE>THE WAYS OF BUTCHERING TURTLES</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1816" ANNOTATION_REF="ann109">
                <ANNOTATION_VALUE>(1) Pull the turtle ashore to the place where you are going to butcher it.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1817" ANNOTATION_REF="ann112">
                <ANNOTATION_VALUE>(2) Thoroughly wash the sand off.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1818" ANNOTATION_REF="ann115">
                <ANNOTATION_VALUE>(3) Hit the turtle dead, hit it on its throat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1819" ANNOTATION_REF="ann118">
                <ANNOTATION_VALUE>Cut the shell on its chest, subsequently cut the sides.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1820" ANNOTATION_REF="ann121">
                <ANNOTATION_VALUE>Then you take its shell off.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1821" ANNOTATION_REF="ann124">
                <ANNOTATION_VALUE>Search for the upper end of the intestines that begin in its throat,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1822" ANNOTATION_REF="ann127">
                <ANNOTATION_VALUE>cut them off, pull them out of the belly of the turtle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1823" ANNOTATION_REF="ann130">
                <ANNOTATION_VALUE>When you have completely pulled out the instestines and the other things in the turtle,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1824" ANNOTATION_REF="ann133">
                <ANNOTATION_VALUE>scoop the blood out.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1825" ANNOTATION_REF="ann136">
                <ANNOTATION_VALUE>Cut off  its flippers (the four) and the head.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1826" ANNOTATION_REF="ann139">
                <ANNOTATION_VALUE>Light a big fire for heating the pieces of the turtle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1827" ANNOTATION_REF="ann142">
                <ANNOTATION_VALUE>After having heated them up, put the turtle pieces on a mat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1828" ANNOTATION_REF="ann145">
                <ANNOTATION_VALUE>Cut the turtle pieces further up, then you cut enough for each turtle parcel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1829" ANNOTATION_REF="ann148">
                <ANNOTATION_VALUE>(10) Wrap the turtle up into parcels. When it's finished in this way, put (the parcels) into the earth oven.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1830" ANNOTATION_REF="ann151">
                <ANNOTATION_VALUE>The parts inside the turtle are eaten by the Teop people</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1831" ANNOTATION_REF="ann154">
                <ANNOTATION_VALUE>The intestines are cut into short pieces,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1832" ANNOTATION_REF="ann157">
                <ANNOTATION_VALUE>then they are torn into strips,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1833" ANNOTATION_REF="ann160">
                <ANNOTATION_VALUE>then properly washed</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1834" ANNOTATION_REF="ann163">
                <ANNOTATION_VALUE>and put into a pot.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1835" ANNOTATION_REF="ann166">
                <ANNOTATION_VALUE>The lungs are also cut up and put into a pot.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1836" ANNOTATION_REF="ann169">
                <ANNOTATION_VALUE>Also the following parts, the heart, cartilages, and the other parts</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1837" ANNOTATION_REF="ann172">
                <ANNOTATION_VALUE>When it is finished, the pot is set on the fire.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1838" ANNOTATION_REF="ann175">
                <ANNOTATION_VALUE>It is cooked with ginger, so that it tastes good.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="free transl." PARTICIPANT="unknown" TIER_ID="lit. transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1839" ANNOTATION_REF="a1787">
                <ANNOTATION_VALUE>(lit. The two flippers at its back (are the ones) that it steers with.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1840" ANNOTATION_REF="a1795">
                <ANNOTATION_VALUE>(lit. (It is) many eggs indeed that the turtle lays.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1841" ANNOTATION_REF="a1802">
                <ANNOTATION_VALUE>(lit. The turtle they get hold of with the net.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1842" ANNOTATION_REF="a1803">
                <ANNOTATION_VALUE>(lit. this (means) ...)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1843" ANNOTATION_REF="a1806">
                <ANNOTATION_VALUE>(lit. (There are) some times that they go dive (for) turtles.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1844" ANNOTATION_REF="a1808">
                <ANNOTATION_VALUE>(lit. At the times (of) fishing with torches, they also find the turtle, this (is) when low tide blocking (it) in the lagoons.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1846" ANNOTATION_REF="a1809">
                <ANNOTATION_VALUE>(lit. What (is it) like that the men of the Teop region butcher turtles differently.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1845" ANNOTATION_REF="a1810">
                <ANNOTATION_VALUE>(lit. In former times, the butchering (of) turtles, only big men (were the ones) who did it.)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
