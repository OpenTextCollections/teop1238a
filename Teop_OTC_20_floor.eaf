    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="unknown" TIER_ID="text">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a393" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>O paranda o peho taba vaa tea inu teara a ta Teapu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann7" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>Eove to kom, hio ae goroho raara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann10" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>O paranda na vavaobete raara toon na naono vai to dao raara bono hogo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann13" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>O paranda na pakupaku raara bono kobuu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann16" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>Tea meha maa vaan na pakupaku riori bono kumako.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann19" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>Beara tau paku o paranda, eara toro ipinoo roho a bebeahu ae a tatabonata na inu bono kara urisi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann22" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>O kara urisi bona to kahi dee raara rasuu to kahi ipinoo raara o kobuu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann25" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>Beara suguna teo hum to tei nae o kobuu, eara paa sisira roho tea tabae o kobuu toro paku ara bono paranda toro vuaba vai o manoto.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann28" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>Beara viana vakavara o kobuu vai tau paku ara o paranda, eara repaa mosi gunaha e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann31" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>O kobuu vai o kobusu saka mataa haana,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann34" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>eikou na antee vaha koana tea koava, evehee o vuaba vai o manoto vamataa na antee nana tea tei vananaoana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann37" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>Beo kobuu obete nana putaa, eara repaa ipinoo e,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann40" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>eara repaa rom suku bata koara o ipinoo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann43" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>Beara romrom vakavara e, eara repaa paku pete a kiu vaa tea kopaa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann46" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>Eara he toro kopaa e teo hum buaku.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann49" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>Tea kiu vaa tea kopaa, eara toro kiu nia buaku a toraaraa, ae amaa ta ginuva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann52" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>Tea kopaa, eara toro mosi momohu nia peha toraaraa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann55" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>ore topo vakisi nana, beara mosi nia vaabuaku.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann58" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>A vaabuaku re topo vakisi nana, beara rahi pute a toraaraa momohu,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann61" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>beara tapa bata ni naora amaa ta ginuva teo hum to mosi vaakaa bata naona a bua toraaraa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann64" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>Eara pasi paku bata koa vo naora teebona, ore antee komana beo rom kobuu takopaa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann67" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>Be kavara o hum kiu bona, eara repaa paku pete o hum vaa tea kopaa varutarutaa e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann70" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>A kiu bona sa beera vaha haana,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann73" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>na antee koana bona peha toraaraa.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann76" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>Beara kopaa varutarutaa bata rae, eara mee toro ipinoo batara a tatabonata bona bebeahu na kobisi kuriraara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann79" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>Be kavara a kiu bona, eara repaa tarataraha kahie bono ogana nae</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann82" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>ae taraha taatagi koa amaa ta kobuu, ore paa kavara kou a kiu vaa teebona.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann85" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>A kiu vaa tea paku paranda a hihivaa,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann88" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>eikou o kobuu o taba kikis, ei mee vaaponis rakaha nana bona kiu bona.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann91" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>Ei, eara deedee voosu vai, are paa no vaobete e tea inu, ore paa tavus paranda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="ref" PARTICIPANT="unknown" TIER_ID="free transl.">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a392">
                <ANNOTATION_VALUE>The floor is a thing in our house, the Teop people.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann8" ANNOTATION_REF="ann6">
                <ANNOTATION_VALUE>It is where we step, sit, and sleep on.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann11" ANNOTATION_REF="ann9">
                <ANNOTATION_VALUE>We put the floor onto the beams that we call hogo (floor joists).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann14" ANNOTATION_REF="ann12">
                <ANNOTATION_VALUE>We make the floor from the kobuu palm (a cyrtostachys species).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann17" ANNOTATION_REF="ann15">
                <ANNOTATION_VALUE>In other villages they make it from the kumako palm (areca novohibernica).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann20" ANNOTATION_REF="ann18">
                <ANNOTATION_VALUE>When we are about to make the floor, we must measure the length and the width of the house with a tape made of the wild banana sheath..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann23" ANNOTATION_REF="ann21">
                <ANNOTATION_VALUE>This wild banana sheath tape we take to the jungle where we will measure the kobuu palm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann26" ANNOTATION_REF="ann24">
                <ANNOTATION_VALUE>When we have arrived at the place where the kobuu palm stands, we carefully examine (it), because the kobuu palm from which we will make the floor must be a mature one.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann29" ANNOTATION_REF="ann27">
                <ANNOTATION_VALUE>When we have chosen the kobuu palm that we are about to make the floor from, we cut it down.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann32" ANNOTATION_REF="ann30">
                <ANNOTATION_VALUE>The young and moist  kobuu palm is not good,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann35" ANNOTATION_REF="ann33">
                <ANNOTATION_VALUE>because it can easily rot, but the fully mature one can last for a long time.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann38" ANNOTATION_REF="ann36">
                <ANNOTATION_VALUE>When the kobuu palm is lying on the ground, we measure it,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann41" ANNOTATION_REF="ann39">
                <ANNOTATION_VALUE>and then we just cut the stem crosswise according to the measure.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann44" ANNOTATION_REF="ann42">
                <ANNOTATION_VALUE>When we have finished cutting it up crosswise, we subsequently do the work of cutting it lengthwise.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann47" ANNOTATION_REF="ann45">
                <ANNOTATION_VALUE>But we must cut it lengthwise into two pieces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann50" ANNOTATION_REF="ann48">
                <ANNOTATION_VALUE>For the work of the lengthwise cutting, we must work with two axes and some wedges.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann53" ANNOTATION_REF="ann51">
                <ANNOTATION_VALUE>For the lengthwise cut, we must first make a cut with one axe</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann56" ANNOTATION_REF="ann54">
                <ANNOTATION_VALUE>so that it is still stuck (in the stem) when we make a cut with the second (axe).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann59" ANNOTATION_REF="ann57">
                <ANNOTATION_VALUE>Then the second (axe) is still stuck (in the stem), when we pull out the first axe,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann62" ANNOTATION_REF="ann60">
                <ANNOTATION_VALUE>while we are driving the wedges into the stem where the two axes cut it lengthwise open.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann65" ANNOTATION_REF="ann63">
                <ANNOTATION_VALUE>We will do it like this, until the stem of the kobuu palm is cut open lengthwise.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann68" ANNOTATION_REF="ann66">
                <ANNOTATION_VALUE>When this part of work is finished, we continue with the part of cutting it bit by bit lengthwise (into two halves).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann71" ANNOTATION_REF="ann69">
                <ANNOTATION_VALUE>This work is not big again,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann74" ANNOTATION_REF="ann72">
                <ANNOTATION_VALUE>(it) only needs one axe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann77" ANNOTATION_REF="ann75">
                <ANNOTATION_VALUE>While we are cutting it open lengthwise bit by bit, we must also measure the width with the length of our finger.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann80" ANNOTATION_REF="ann78">
                <ANNOTATION_VALUE>When this work is finished, we carve its soft inside out</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann83" ANNOTATION_REF="ann81">
                <ANNOTATION_VALUE>and just carefully carve off some pieces of kobuu palm, and then indeed the work on it is finished.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann86" ANNOTATION_REF="ann84">
                <ANNOTATION_VALUE>The work of making the floor is difficult,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann89" ANNOTATION_REF="ann87">
                <ANNOTATION_VALUE>because the kobuu palm is a hard thing, and this also makes this work very heavy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="ann92" ANNOTATION_REF="ann90">
                <ANNOTATION_VALUE>Now, we carry it home, then we make it lie in the house, so that it becomes a floor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
